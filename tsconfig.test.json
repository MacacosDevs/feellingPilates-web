{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "types": ["node", "vite/client", "google.maps"],
    "strict": true,
    "incremental": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo"
  },
  "include": [
    "vitest.config.ts",
    "playwright.config.ts",
    "tests/**/*.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/test-support/**/*.tsx"
  ]
}
